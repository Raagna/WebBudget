JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API, so rate limits see each
# user's real IP. Defaults to 1 on Render (detected automatically) and 0
# elsewhere. Set to 1 behind nginx/Caddy/Cloudflare Tunnel on a homelab.
# TRUST_PROXY=1

# Postgres connection string. Format:
#   postgresql://user:password@host:port/database
# Defaults to a local dev Postgres (postgres/postgres @ localhost:5432/finance_dev)
# if unset, so `npm start` works against a local Postgres with zero extra
# config - set this to your real connection string for anything hosted.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_dev

# Set to "true" if your Postgres provider requires SSL and your connection
# string doesn't already include ?sslmode=require. Neon and Supabase
# connection strings include sslmode=require by default, so this is
# usually only needed for providers that don't.
# PGSSL=true

# Receipt scanning: a local Ollama server with a vision model. Defaults
# shown. The API must be able to reach this URL, so a backend hosted in
# the cloud needs a tunnel to wherever Ollama runs. If Ollama is
# unreachable, scanning returns a friendly error and the rest of the app
# works as normal.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5vl:7b
# SCAN_TIMEOUT_MS=120000

# CSV import asks the same local model to categorize merchants nothing
# else recognizes. Skipped quietly when Ollama is unreachable; set to off
# to never ask.
# IMPORT_MODEL_LOOKUP=on
# IMPORT_MODEL_TIMEOUT_MS=60000

# Investments: prices from Yahoo Finance's public chart endpoint (no key;
# unofficial, so it can change without notice). Cached per symbol.
# QUOTES_URL=https://query1.finance.yahoo.com
# QUOTE_TTL_MS=900000

# Wealthsimple holdings sync through SnapTrade (optional). Wealthsimple has
# no public API; SnapTrade connects to it for you. Make a free Personal key
# at https://dashboard.snaptrade.com, connect Wealthsimple there (read
# only), and paste the key here. A Personal key is for one person's own
# accounts, so only the WebBudget login in SNAPTRADE_OWNER_EMAIL can sync
# with it. Keep these on the server: never put them in the frontend.
# Without them, the Holdings report CSV import still works.
# SNAPTRADE_CLIENT_ID=
# SNAPTRADE_CONSUMER_KEY=
# SNAPTRADE_OWNER_EMAIL=you@example.com
# SNAPTRADE_URL=https://api.snaptrade.com

# Dashboard news: headlines from public RSS feeds, cached in memory.
# Default feeds: CBC Business, The Globe and Mail, MarketWatch, Bank of
# Canada. Override with a comma list of Name|url.
# NEWS_FEEDS=CBC Business|https://www.cbc.ca/webfeed/rss/rss-business
# NEWS_TTL_MS=1800000

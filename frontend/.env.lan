# Loaded only by `--mode lan` (npm run preview:lan). The built app calls the
# API on its own origin, and `vite preview` forwards /api to the backend
# (server.proxy in vite.config.js), so the phone needs just one address.
# Without this a production build calls http://localhost:4000/api, which on
# the phone is the phone itself.
VITE_API_URL=/api
